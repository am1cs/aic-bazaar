{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true,
    "types": ["vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@aic-bazaar/sdk": ["../sdk/src/index.ts"],
      "@coral-xyz/anchor": ["node_modules/@coral-xyz/anchor"],
      "@solana/web3.js": ["node_modules/@solana/web3.js"],
      "bn.js": ["node_modules/@types/bn.js"],
      "bs58": ["node_modules/bs58"],
      "buffer": ["node_modules/buffer"]
    }
  },
  "include": ["src", "checks", "vite.config.ts", "vite.devnet.config.ts", "../shared", "../sdk/src"]
}
